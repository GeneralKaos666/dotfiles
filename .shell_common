# Shared shell profile - sourced by both bash and zsh
# Created by aidevops setup to preserve customizations across shell switches
# Edit this file for settings you want in BOTH bash and zsh
# Shell-specific settings go in ~/.bashrc or ~/.zshrc


# From .bash_profile
export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require $HOME/.copilot-hooks/keytar-bypass.js"

# From .bashrc
export LS_COLORS="di=95"
export PATH=$PATH:$JAVA_HOME/bin
export PATH=$PATH:/data/data/com.termux/files/home/termux/android-studio/bin
